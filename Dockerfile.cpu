FROM python:3.11-slim-bookworm

ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 CUDA_VISIBLE_DEVICES=""
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg git libsndfile1 ca-certificates && rm -rf /var/lib/apt/lists/*
RUN pip install torch==2.6.0 torchaudio==2.6.0 --index-url https://download.pytorch.org/whl/cpu
COPY requirements.txt /app/requirements.txt
RUN pip install -r requirements.txt
ARG GIGAAM_REV=7447938d791c4f3e643386ee22c33777004293a5
RUN pip install "git+https://github.com/salute-developers/GigaAM.git@${GIGAAM_REV}"
COPY app.py subtitles.py /app/
COPY templates /app/templates
EXPOSE 8000
CMD ["python", "app.py"]
